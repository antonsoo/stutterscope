{
  "name": "stutterscope",
  "version": "0.1.0",
  "description": "Frame-time analysis for PC gamers and hardware reviewers. Drop in a capture, see the stutter.",
  "author": "Anton Soloviev",
  "license": "MIT",
  "type": "module",
  "private": true,
  "homepage": "https://antonsoo.github.io/stutterscope/",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/stutterscope.git"
  },
  "keywords": [
    "frame-time",
    "frametime",
    "presentmon",
    "fps",
    "stutter",
    "benchmarking",
    "gaming",
    "performance"
  ],
  "bin": {
    "stutterscope": "./bin/stutterscope.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "samples": "node scripts/generate-samples.ts",
    "cli": "node src/cli/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "uplot": "^1.6.32",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
