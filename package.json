{
  "name": "@antonsoloviev/stutterscope",
  "version": "0.2.5",
  "description": "Frame-time analysis for PC gamers and hardware reviewers. Drop in a capture, see the stutter.",
  "author": "Anton Soloviev",
  "license": "MIT",
  "type": "module",
  "homepage": "https://antonsoo.github.io/stutterscope/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonsoo/stutterscope.git"
  },
  "keywords": [
    "frame-time",
    "frametime",
    "presentmon",
    "fps",
    "stutter",
    "benchmarking",
    "gaming",
    "performance"
  ],
  "bin": {
    "stutterscope": "./dist-cli/cli/index.js"
  },
  "files": [
    "dist-cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "prepare": "npm run build:cli",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "samples": "node scripts/generate-samples.ts",
    "cli": "node src/cli/index.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "uplot": "^1.6.32",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
